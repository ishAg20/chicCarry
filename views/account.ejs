<%- include('./partials/header') %>
<div class="w-full px-4 sm:px-6 md:px-10 py-20">
  <div
    class="w-full max-w-5xl mx-auto flex flex-col gap-6 sm:gap-10 bg-gray-100 p-4 sm:p-8 rounded-lg"
  >
    <div class="text-center">
      <h1 class="text-lg sm:text-2xl font-bold">
        Welcome, <%= user.fullname.split(' ')[0] %>!
      </h1>
      <p class="text-gray-600 mt-2 text-sm sm:text-base">
        Manage your account, track orders, and update your preferences.
      </p>
    </div>

    <div class="flex flex-col gap-6 sm:gap-8">
      <!-- Account Details -->
      <div class="bg-white shadow-md p-4 sm:p-6 rounded-lg">
        <h2 class="text-lg sm:text-xl font-bold mb-3">Account Details</h2>
        <div class="space-y-2 text-sm sm:text-base">
          <p><strong>Name:</strong> <%= user.fullname %></p>
          <p><strong>Email:</strong> <%= user.email %></p>
          <p><strong>Phone:</strong> <%= user.contact %></p>
          <a
            class="text-blue-500 hover:text-blue-600 mt-3 block"
            href="/users/account/edit"
            >Edit Details</a
          >
        </div>
      </div>

      <!-- Order History -->
      <div class="bg-white shadow-md p-4 sm:p-6 rounded-lg">
        <h2 class="text-lg sm:text-xl font-bold mb-3">Order History</h2>
        <% if (user.orders.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="min-w-full table-auto border border-gray-300">
            <thead class="bg-gray-200">
              <tr>
                <th
                  class="border px-3 sm:px-4 py-2 text-left text-xs sm:text-sm"
                >
                  Order ID
                </th>
                <th
                  class="border px-3 sm:px-4 py-2 text-left text-xs sm:text-sm"
                >
                  Total (₹)
                </th>
                <th
                  class="border px-3 sm:px-4 py-2 text-left text-xs sm:text-sm"
                >
                  Date
                </th>
                <th class="border px-3 sm:px-4 py-2 text-xs sm:text-sm">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody>
              <% user.orders.forEach(order => { %>
              <tr class="odd:bg-white even:bg-gray-50">
                <td class="border px-3 sm:px-4 py-2 text-xs sm:text-sm">
                  <%= order.orderId %>
                </td>
                <td class="border px-3 sm:px-4 py-2 text-xs sm:text-sm">
                  <%= order.total %>
                </td>
                <td class="border px-3 sm:px-4 py-2 text-xs sm:text-sm">
                  <%= new Date(order.createdAt).toLocaleDateString() %>
                </td>
                <td
                  class="border px-3 sm:px-4 py-2 text-center text-xs sm:text-sm"
                >
                  <a
                    href="/users/account/orders/<%= order.orderId %>"
                    class="text-blue-500 hover:underline"
                    >Details</a
                  >
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <p class="text-gray-600 text-sm sm:text-base">
          You have not placed any orders yet.
        </p>
        <% } %>
      </div>

      <!-- Saved Addresses -->
      <div class="bg-white shadow-md p-4 sm:p-6 rounded-lg">
        <h2 class="text-lg sm:text-xl font-bold mb-3">Saved Addresses</h2>
        <% if (user.addresses.length > 0) { %>
        <ul class="space-y-3 text-sm sm:text-base">
          <% user.addresses.forEach(address => { %>
          <li>
            <p><strong><%= address.label %>:</strong></p>
            <p>
              <%= address.street %>, <%= address.city %>, <%= address.zip %>
            </p>
          </li>
          <% }); %>
        </ul>
        <% } else { %>
        <p class="text-sm sm:text-base">No saved addresses.</p>
        <% } %>
        <a
          class="text-blue-500 hover:text-blue-600 mt-3 block text-sm sm:text-base"
          href="/users/account/address"
          >Manage Addresses</a
        >
      </div>
    </div>
  </div>
</div>
<%- include('./partials/footer') %>
