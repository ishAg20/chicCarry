<%- include('./partials/header') %>
<div class="w-full h-screen flex items-start px-20 py-20">
  <div
    class="w-[85%] mx-auto flex flex-col gap-10 h-screen px-10 py-5 bg-gray-100"
  >
    <div class="text-center">
      <h1 class="text-2xl font-bold">
        Welcome, <%= user.fullname.split(' ')[0] %>!
      </h1>
      <p class="text-gray-600 mt-2">
        Manage your account, track orders, and update your preferences.
      </p>
    </div>
    <div class="flex flex-col gap-8">
      <div class="bg-white shadow-md p-5 rounded-lg">
        <h2 class="text-xl font-bold mb-3">Account Details</h2>
        <p><strong>Name:</strong> <%= user.fullname %></p>
        <p><strong>Email:</strong> <%= user.email %></p>
        <p><strong>Phone:</strong> <%= user.contact %></p>
        <a class="text-blue-500 mt-3 block" href="/users/account/edit"
          >Edit Details</a
        >
      </div>

      <div class="bg-white shadow-md p-5 rounded-lg">
        <h2 class="text-xl font-bold mb-3">Order History</h2>
        <% if (user.orders.length > 0) { %>
        <ul class="list-disc pl-5">
          <% user.orders.forEach(order => { %>
          <li>
            <span><strong>Order ID:</strong> <%= order.orderId %></span> -
            <span><strong>Total:</strong> ₹<%= order.total %></span> -
            <span><strong>Status:</strong> <%= order.items %></span>
          </li>
          <% }); %>
        </ul>
        <% } else { %>
        <p>You have not placed any orders yet.</p>
        <% } %>
        <a class="text-blue-500 mt-3 block" href="/account/orders"
          >View All Orders</a
        >
      </div>

      <div class="bg-white shadow-md p-5 rounded-lg">
        <h2 class="text-xl font-bold mb-3">Saved Addresses</h2>
        <% if (user.addresses.length > 0) { %>
        <ul>
          <% user.addresses.forEach(address => { %>
          <li class="mb-3">
            <p><strong><%= address.label %>:</strong></p>
            <p>
              <%= address.street %>, <%= address.city %>, <%= address.zip %>
            </p>
          </li>
          <% }); %>
        </ul>
        <% } else { %>
        <p>No saved addresses.</p>
        <% } %>
        <a class="text-blue-500 mt-3 block" href="/users/account/address"
          >Manage Addresses</a
        >
      </div>
    </div>
  </div>
</div>
<%- include('./partials/footer') %>
