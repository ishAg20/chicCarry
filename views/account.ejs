<%- include('./partials/header') %>
<div class="w-full px-10 py-20">
  <div class="w-full max-w-5xl mx-auto flex flex-col gap-10 bg-gray-100 p-8">
    <div class="text-center">
      <h1 class="text-2xl font-bold">
        Welcome, <%= user.fullname.split(' ')[0] %>!
      </h1>
      <p class="text-gray-600 mt-2">
        Manage your account, track orders, and update your preferences.
      </p>
    </div>
    <div class="flex flex-col gap-8">
      <div class="bg-white shadow-md p-5 rounded-lg">
        <h2 class="text-xl font-bold mb-3">Account Details</h2>
        <p><strong>Name:</strong> <%= user.fullname %></p>
        <p><strong>Email:</strong> <%= user.email %></p>
        <p><strong>Phone:</strong> <%= user.contact %></p>
        <a class="text-blue-500 mt-3 block" href="/users/account/edit"
          >Edit Details</a
        >
      </div>
      <div class="bg-white shadow-md p-5 rounded-lg">
        <h2 class="text-xl font-bold mb-3">Order History</h2>
        <% if (user.orders.length > 0) { %>
        <div class="overflow-x-auto">
          <table
            class="min-w-full table-auto border-collapse border border-gray-200"
          >
            <thead class="bg-gray-100">
              <tr>
                <th class="border border-gray-200 px-4 py-2 text-left">
                  Order ID
                </th>
                <th class="border border-gray-200 px-4 py-2 text-left">
                  Total (₹)
                </th>
                <th class="border border-gray-200 px-4 py-2 text-left">Date</th>
                <th class="border border-gray-200 px-4 py-2">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% user.orders.forEach(order => { %>
              <tr class="odd:bg-white even:bg-gray-50">
                <td class="border border-gray-200 px-4 py-2">
                  <%= order.orderId %>
                </td>
                <td class="border border-gray-200 px-4 py-2">
                  <%= order.total %>
                </td>
                <td class="border border-gray-200 px-4 py-2">
                  <%= new Date(order.createdAt).toLocaleDateString() %>
                </td>
                <td class="border border-gray-200 px-4 py-2 text-center">
                  <a
                    href="/users/account/orders/<%= order.orderId %>"
                    class="text-blue-500 hover:underline"
                    >Details</a
                  >
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <% } else { %>
        <p class="text-gray-600">You have not placed any orders yet.</p>
        <% } %>
      </div>

      <div class="bg-white shadow-md p-5 rounded-lg">
        <h2 class="text-xl font-bold mb-3">Saved Addresses</h2>
        <% if (user.addresses.length > 0) { %>
        <ul>
          <% user.addresses.forEach(address => { %>
          <li class="mb-3">
            <p><strong><%= address.label %>:</strong></p>
            <p>
              <%= address.street %>, <%= address.city %>, <%= address.zip %>
            </p>
          </li>
          <% }); %>
        </ul>
        <% } else { %>
        <p>No saved addresses.</p>
        <% } %>
        <a class="text-blue-500 mt-3 block" href="/users/account/address"
          >Manage Addresses</a
        >
      </div>
    </div>
  </div>
</div>
<%- include('./partials/footer') %>
