<%- include('./partials/header-index') %>

<div class="mt-16 flex justify-center items-center w-full">
  <% if (error) { %>
    <div class="alert alert-danger bg-red-500 text-white px-4 py-2 rounded-md shadow-md text-center w-3/4 md:w-1/2">
      <%= error %>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="alert alert-success bg-green-500 text-white px-4 py-2 rounded-md shadow-md text-center w-3/4 md:w-1/2">
      <%= success %>
    </div>
  <% } %>
</div>

<script>
  // Auto-hide messages after 5 seconds
  setTimeout(() => {
    const errorMsg = document.querySelector(".alert-danger");
    const successMsg = document.querySelector(".alert-success");
    if (errorMsg) errorMsg.style.display = "none";
    if (successMsg) successMsg.style.display = "none";
  }, 5000);
</script>

<div class="w-full h-screen flex flex-col md:flex-row px-4 md:px-20 justify-center items-center">
  <!-- Registration Section -->
  <div class="w-full md:w-1/2 flex items-center justify-center py-4 md:py-0">
    <div class="w-full max-w-md px-4 md:px-12 text-center md:text-left">
      <h3 class="text-2xl md:text-4xl mb-2">
        Welcome to <span class="text-blue-400 font-semibold">chicCarry</span>
      </h3>
      <h4 class="text-lg md:text-2xl mb-5">Create your account</h4>
      <form autocomplete="off" action="/users/register" method="post">
        <input class="bg-zinc-100 block w-full px-3 py-2 border border-zinc-200 rounded-md mb-3" type="text" placeholder="Full Name" name="fullname" />
        <input class="bg-zinc-100 block w-full px-3 py-2 border border-zinc-200 rounded-md mb-3" type="email" placeholder="Email" name="email" />
        <input class="bg-zinc-100 block w-full px-3 py-2 border border-zinc-200 rounded-md mb-3" type="password" placeholder="Password" name="password" />
        <input class="w-full md:w-auto px-5 rounded-full py-3 mt-2 bg-blue-500 text-white hover:bg-blue-600 transition-colors" type="submit" value="Create My Account" />
      </form>
    </div>
  </div>

  <!-- Login Section -->
  <div class="w-full md:w-1/2 flex items-center justify-center py-4 md:py-0">
    <div class="w-full max-w-md px-4 md:px-12 text-center md:text-left">
      <h4 class="text-lg md:text-2xl capitalize mb-5">Login to your account</h4>
      <form autocomplete="off" action="/users/login" method="post">
        <input class="block bg-zinc-100 w-full px-3 py-2 border border-zinc-200 rounded-md mb-3" type="email" placeholder="Email" name="email" />
        <input class="block bg-zinc-100 w-full px-3 py-2 border border-zinc-200 rounded-md mb-3" type="password" placeholder="Password" name="password" />
        <input class="w-full md:w-auto px-5 block rounded-full py-3 mt-2 bg-blue-500 text-white hover:bg-blue-600 transition-colors" type="submit" value="Login" />
      </form>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
