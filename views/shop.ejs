<%- include('./partials/header') %>
<div class="w-full h-screen flex items-start px-20 py-20">
  <div class="w-[25%] flex h-screen flex-col items-start">
    <div class="flex items-center gap-2">
      <h3>Sort by</h3>
      <form action="/users/products" method="GET">
        <select
        class="border-[1px] px-2 py-1"
        name="sortby"
        id="sortby"
        onchange="window.location.href = '/users/products?sortby=' + this.value"
      ><option value="newest" <%= sortby === 'newest' ? 'selected' : '' %>>Newest First</option>
        <option value="pricelh" <%= sortby === 'pricelh' ? 'selected' : '' %>>Price (Lowest to Highest)</option>
        <option value="pricehl" <%= sortby === 'pricehl' ? 'selected' : '' %>>Price (Highest to Lowest)</option>
      </select>
    </form>
    </div>
  </div>
  <div class="w-[75%] flex flex-col gap-5 h-screen">
    <div class="flex flex-wrap gap-5">
      <% products.forEach(function(product, index) { %>
      <div class="w-60 flex-shrink-0">
        <div class="w-full h-52 flex items-center justify-center" style="background-color: <%= product.bgcolor %>">
          <img class="h-[12rem] object-contain" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>" />
        </div>
        <div class="flex justify-between items-center px-4 py-4" style="background-color: <%= product.panelcolor %>; color: <%= product.textcolor %>;">
          <div>
            <h3 class="text-lg font-semibold"><%= product.name %></h3>
            <h4 class="text-sm font-medium">₹ <%= product.price %></h4>
          </div>
          <a class="w-7 h-7 flex items-center justify-center rounded-full bg-white shadow-md" href="/products/addtocart/<%= product._id %>" style="color: <%= product.panelcolor %>" aria-label="Add <%= product.name %> to cart">
            <i class="ri-add-line"></i>
          </a>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
