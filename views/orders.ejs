<%- include('./partials/header') %>
<div
  class="w-full min-h-screen flex flex-col items-center px-4 sm:px-8 lg:px-20 py-10 sm:py-20"
>
  <div
    class="w-full lg:w-[85%] mx-auto flex flex-col gap-10 bg-gray-100 rounded-lg p-5 sm:p-10"
  >
    <div class="bg-white shadow-md p-5 sm:p-8 rounded-lg w-full">
      <h2 class="text-xl sm:text-2xl font-bold mb-3 text-center">
        Order Details
      </h2>
      <% if (order) { %>
      <div class="border-t border-gray-200 mt-3">
        <div class="py-3 space-y-2">
          <p class="text-sm sm:text-base">
            <strong>Order ID:</strong> <%= order.orderId %>
          </p>
          <p class="text-sm sm:text-base">
            <strong>Order Date:</strong> <%= new
            Date(order.createdAt).toLocaleDateString() %>
          </p>
          <p class="text-sm sm:text-base">
            <strong>Total Amount:</strong> ₹<%= order.total %>
          </p>
        </div>
        <h3 class="text-lg sm:text-xl font-semibold mt-5 mb-3">Items</h3>
        <div class="overflow-x-auto">
          <table
            class="w-full table-auto border-collapse border border-gray-200 text-sm sm:text-base"
          >
            <thead class="bg-gray-100">
              <tr>
                <th class="border border-gray-200 px-2 sm:px-4 py-2 text-left">
                  Product
                </th>
                <th class="border border-gray-200 px-2 sm:px-4 py-2 text-left">
                  Name
                </th>
                <th class="border border-gray-200 px-2 sm:px-4 py-2 text-left">
                  Price (₹)
                </th>
                <th class="border border-gray-200 px-2 sm:px-4 py-2 text-left">
                  Subtotal (₹)
                </th>
              </tr>
            </thead>
            <tbody>
              <% order.items.forEach(item => { %>
              <tr class="odd:bg-white even:bg-gray-50">
                <td
                  class="border border-gray-200 px-2 sm:px-4 py-2 text-center"
                >
                  <img
                    src="data:image/png;base64,<%= item.product.image.toString('base64') %>"
                    alt="<%= item.product.name %>"
                    class="w-16 h-16 sm:w-20 sm:h-20 object-contain mx-auto"
                  />
                </td>
                <td class="border border-gray-200 px-2 sm:px-4 py-2">
                  <%= item.product.name %>
                </td>
                <td
                  class="border border-gray-200 px-2 sm:px-4 py-2 text-center"
                >
                  ₹<%= item.product.price %>
                </td>
                <td
                  class="border border-gray-200 px-2 sm:px-4 py-2 text-center"
                >
                  ₹<%= item.product.discount %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
      <a
        class="text-blue-600 hover:text-blue-800 mt-5 inline-block text-sm sm:text-base"
        href="/users/account"
        >Back to Orders</a
      >
      <% } else { %>
      <p class="text-gray-600 text-sm sm:text-base">Order not found.</p>
      <% } %>
    </div>
  </div>
</div>
<%- include('./partials/footer') %>
