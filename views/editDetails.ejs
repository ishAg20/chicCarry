<%- include('./partials/header') %>
<div class="w-full min-h-screen flex items-center justify-center px-6 py-10">
  <div
    class="w-full max-w-lg md:max-w-2xl lg:w-1/2 mx-auto flex flex-col gap-6 p-6 bg-gray-100 rounded-lg shadow-md"
  >
    <div class="text-center">
      <h1 class="text-2xl font-bold">Edit Account Details</h1>
      <p class="text-gray-600 mt-2">Update your account information below.</p>
    </div>
    <div class="bg-white shadow-md p-6 rounded-lg">
      <form
        action="/users/account/edit"
        method="post"
        class="flex flex-col gap-5"
      >
        <div>
          <label for="fullname" class="block text-gray-700 font-bold"
            >Full Name:</label
          >
          <input
            type="text"
            id="fullname"
            name="fullname"
            value="<%= user.fullname %>"
            class="w-full border border-gray-300 rounded-md p-2 mt-1 focus:ring-2 focus:ring-blue-400"
          />
        </div>
        <div>
          <label for="email" class="block text-gray-700 font-bold"
            >Email:</label
          >
          <input
            type="email"
            id="email"
            name="email"
            value="<%= user.email %>"
            class="w-full border border-gray-300 rounded-md p-2 mt-1 focus:ring-2 focus:ring-blue-400"
          />
        </div>
        <div>
          <label for="contact" class="block text-gray-700 font-bold"
            >Phone:</label
          >
          <input
            type="text"
            id="contact"
            name="contact"
            value="<%= user.contact %>"
            class="w-full border border-gray-300 rounded-md p-2 mt-1 focus:ring-2 focus:ring-blue-400"
          />
        </div>
        <button
          type="submit"
          class="bg-blue-500 text-white font-bold py-2 px-4 rounded-md hover:bg-blue-600 transition duration-300"
        >
          Save Changes
        </button>
      </form>
    </div>
  </div>
</div>
<%- include('./partials/footer') %>
